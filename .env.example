# ==============================================================================
# Konfigurasi Lingkungan Asisten Kaji Kitab & Turats
# Salin file ini menjadi '.env.local' untuk pengembangan lokal atau deployment server.
# JANGAN PERNAH menyertakan API Key riil ke dalam version control (Git).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Provider Utama: SumoPod AI (OpenAI Compatible)
# ------------------------------------------------------------------------------
# Kunci API dari SumoPod (dapatkan di https://sumopod.com/dashboard/ai)
SUMOPOD_API_KEY=your_sumopod_api_key_here

# Base URL endpoint API (default: https://ai.sumopod.com/v1)
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Model LLM yang digunakan untuk chat teks harian (default: gpt-4o-mini)
SUMOPOD_MODEL=gpt-4o-mini

# Model Multimodal Vision OCR untuk foto lembaran kitab naskah (rekomendasi: gemini/gemini-3.7-flash)
SUMOPOD_VISION_MODEL=gemini/gemini-3.7-flash

# ------------------------------------------------------------------------------
# 2. Provider Alternatif: Google Gemini API (Opsional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
